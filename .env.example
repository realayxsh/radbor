# Create a webhook for a private payment-review channel and keep its URL secret.
DISCORD_PAYMENT_WEBHOOK_URL=

# Discord Developer Portal > your bot application's OAuth2 settings.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain.example/auth/discord/callback
# Public HTTPS origin used to create private review links in payment notifications.
# Set this in Replit Secrets as well as local .env when running the app there.
PUBLIC_BASE_URL=https://radiomusic.in

# Set a long random secret for signed login sessions. Required in production.
SESSION_SECRET=
NODE_ENV=production
# Set TRUST_PROXY=true only when the app is behind a trusted HTTPS reverse proxy.
TRUST_PROXY=true

# Use a persistent writable directory in production to retain website payment history.
# Defaults to .payment-data beside website.js.
PAYMENT_DATA_DIR=
